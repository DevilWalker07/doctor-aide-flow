# ===== FRONTEND (Vite) =====
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui
# Base URL do backend. Em dev deixe vazio (o Vite faz proxy para :8787).
# Em produção na Vercel deixe vazio também (vercel.json reescreve /api para o Railway).

# ===== BACKEND (server/) =====
PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000
# Persistência de jobs de extração e validação de JWT (service_role — nunca expor no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# CSV de origens permitidas (ex.: https://app.vercel.app,https://meudominio.com). Vazio em dev = localhost liberado.
ALLOWED_ORIGINS=
# Autenticação (JWT Supabase em todo /api/*) é obrigatória. AUTH_OPTIONAL=true só em dev/testes sem Supabase.
AUTH_OPTIONAL=false
# true responde com fixtures determinísticas sem chamar a OpenAI (testes)
AI_MOCK=false
MAX_PDF_PAGES=15
