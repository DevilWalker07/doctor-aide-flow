{
  "name": "doctor-aide-flow",
  "version": "0.3.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "agente:analisar": "tsx agents/analista.ts",
    "agente:implementar": "tsx agents/implementador.ts",
    "agente:consultor-medico": "tsx agents/consultor-medico.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project server --project client",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@supabase/supabase-js": "^2.43.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/router-plugin": "^1.167.10",
    "@types/multer": "^2.1.0",
    "@vercel/functions": "^3.9.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "^6.8.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.0"
  }
}
