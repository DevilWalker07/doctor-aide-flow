{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "api/**/*.ts", "agents/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "dist-server"]
}
